| Arquivo: fatorial.simples
| Descricao: Programa de teste - calcula fatorial de um numero
========================================================*/

programa fatorial
    inteiro n fat
inicio
    leia n
    fat <- 1
    enquanto n > 0 faca
        fat <- fat * n
        n <- n - 1
    fimenquanto
    escreva fat
fimprograma
